# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
metastatic-*.tar

/.dialyzer/*plt*

/.elixir-tools/
/.elixir_ls/
/.erl.history/

/.hex/
/.mix/
/.dsh/
/.ragex/

# Yoke agent session/job artifacts (local tooling state, never committed)
/.yoke/

# JavaScript parser node_modules
/priv/parsers/javascript/node_modules/
/priv/parsers/march/_build/
/priv/parsers/sql/target/

# Haskell parser artifacts
*.hi
*.o

# Stack build directory (build outputs, package DBs, caches).
# The compiled parser used at runtime is committed separately as
# priv/parsers/haskell/bin/parser, so nothing here needs tracking.
/priv/parsers/haskell/.stack-work/

# Stray local sockets / crash dumps
*.sock

# Third-party plug-in example: its own Mix project, so its own build dirs.
/examples/third_party_plugin/_build/
/examples/third_party_plugin/deps/

# Rust parser build artifacts
/priv/parsers/rust/target/
